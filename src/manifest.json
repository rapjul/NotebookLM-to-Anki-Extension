{
  "$schema": "https://json.schemastore.org/chrome-manifest",
  "manifest_version": 3,
  "name": "NotebookLM to Anki",
  "version": "4.1.0",
  "version_name": "4.1.0",
  "description": "Exports NotebookLM Quizzes to Anki",
  "permissions": ["storage", "scripting", "cookies", "declarativeNetRequest"],
  "host_permissions": [
    "https://notebook.google.com/*",
    "https://notebooklm.google.com/*",
    "https://*.usercontent.goog/*",
    "https://lh3.google.com/*",
    "https://*.google.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "notebooklm-to-anki@rapjul.github.io",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://notebook.google.com/*",
        "https://notebooklm.google.com/*",
        "https://*.usercontent.goog/*"
      ],
      "js": ["utils.js", "content.js"],
      "css": ["modal.css"],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["modal.html", "button.html"],
      "matches": [
        "https://notebook.google.com/*",
        "https://notebooklm.google.com/*",
        "https://*.usercontent.goog/*"
      ]
    }
  ]
}
