{
  "semi": true,
  "singleQuote": false,
  "tabWidth": 4,
  "useTabs": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "htmlWhitespaceSensitivity": "css",
  "overrides": [
    {
      "files": ["*.html", "*.js", "*.ts", "*.cjs", "*.mjs", "*.svelte"],
      "options": {
        "useTabs": true,
        "tabWidth": 4
      }
    },
    {
      "files": ["*.json", "*.svg", "*.css", "*.yml", "*.yaml"],
      "options": {
        "useTabs": false,
        "tabWidth": 2
      }
    },
    {
      "files": ["*.md"],
      "options": {
        "useTabs": false,
        "tabWidth": 4,
        "proseWrap": "preserve"
      }
    }
  ]
}
